---
import { localeInfo } from '../lib/translations';
import { contentImage } from '../lib/content-image';
import type { Entry } from '../lib/content';
import {
  articleHref,
  readingMinutes,
  taxonomyLabels,
  encodedSlug,
  isReferral,
} from '../lib/content';
import { articleBrand, referralBrand } from '../lib/referral';
import { t, href, dateLabel } from '../lib/i18n';
import { publicRoute } from '../lib/public-routes';
import type { Locale } from '../types/config';
import ThemeIcon from './ThemeIcon.astro';
interface Props {
  entries: Entry[];
  lang: Locale;
  compact?: boolean;
}
const { entries, lang, compact = false } = Astro.props;
const ui = t(lang);
const labels = await taxonomyLabels(lang);
---

<div class:list={['post-list', { compact }]}>
  {entries.length === 0 && <p class="empty-state">{ui.noPosts}</p>}
  {entries.map((entry) => {
    const url = articleHref(entry, lang);
    const category = isReferral(entry)
      ? referralBrand(entry.data)
      : articleBrand(entry.data);
    return (
      <article
        class:list={['post-row', { 'has-cover': Boolean(entry.data.image) }]}
      >
        <div class="post-row-copy">
          <div class="post-row-meta">
            {entry.data.featured && (
              <span class="pin-label">
                <ThemeIcon name="pin" size={13} />
                {ui.featured}
              </span>
            )}
            <time datetime={entry.data.date.toISOString()}>
              {dateLabel(entry.data.date, lang)}
            </time>
            {category && (
              <>
                <span>·</span>
                <a
                  href={href(
                    lang,
                    `${publicRoute('categories')}/${encodedSlug(category)}/`,
                  )}
                >
                  {labels.categories[category] ?? category}
                </a>
              </>
            )}
            {entry.data.draft && <span class="status-label">{ui.draft}</span>}
            {entry.data._locale && entry.data._locale !== lang && (
              <span class="status-label">
                {localeInfo(entry.data.lang).label}
              </span>
            )}
          </div>
          <a class="post-row-title" href={url}>
            <h3>{entry.data.title}</h3>
            {!entry.data.image && <ThemeIcon name="arrow-up-right" size={19} />}
          </a>
          {entry.data.description && (
            <p class="post-description">{entry.data.description}</p>
          )}
        </div>
        {entry.data.image && (
          <a
            class="post-row-cover"
            href={url}
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={contentImage(entry.data.image, url)}
              alt=""
              width="240"
              height="160"
              loading="lazy"
            />
          </a>
        )}
        {!compact && (
          <div class="post-bottom">
            <span>
              {readingMinutes(entry)} {ui.minutes}
            </span>
            <div>
              {entry.data.tags.map((tag) => (
                <a
                  class="tag"
                  href={href(
                    lang,
                    `${publicRoute('tags')}/${encodedSlug(tag)}/`,
                  )}
                >
                  {labels.tags[tag] ?? tag}
                </a>
              ))}
            </div>
          </div>
        )}
      </article>
    );
  })}
</div>

---
import { pageLocale } from '../../lib/i18n';
import config from '../../lib/config';
import Layout from '../../layouts/Layout.astro';
import SearchBox from '../../components/SearchBox.astro';
import PostList from '../../components/PostList.astro';
import ThemeIcon from '../../components/ThemeIcon.astro';
import { entriesFor } from '../../lib/content';
import { absoluteUrl } from '../../lib/seo';
import { publicRoute } from '../../lib/public-routes';
import { href, localize, t } from '../../lib/i18n';
const lang = pageLocale(Astro.routePattern);
const posts = (await entriesFor(lang)).slice(0, config.posts.homeLimit);
const ui = t(lang);
---

<Layout
  lang={lang}
  active="home"
  breadcrumbs={[
    {
      name: localize(config.text.tabs.search, lang),
      url: absoluteUrl(href(lang)),
    },
  ]}
>
  <section class="home-stage" aria-label={ui.home}>
    <div class="home-heading-anchor">
      <div class="home-heading-text">
        <h1>{localize(config.text.homeHeading, lang)}</h1>
      </div>
    </div>
    <div class="content-column home-composer-wrap">
      <SearchBox lang={lang} home />
    </div>
  </section>
  <div class="content-column home-recent">
    <section>
      <div class="section-heading">
        <h2>{ui.recent}</h2>
        <a href={href(lang, `${publicRoute('referrals')}/`)}>
          {ui.allReferrals}
          <ThemeIcon name="arrow-right" size={15} />
        </a>
      </div>
      <PostList entries={posts} lang={lang} compact />
    </section>
  </div>
</Layout>

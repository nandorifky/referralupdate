---
import { pageLocale } from '../../lib/i18n';
import config from '../../lib/config';
import ContentIntro from '../../components/ContentIntro.astro';
import {
  introFor,
  discoverableEntries,
  articleHref,
  isReferral,
  type Entry,
} from '../../lib/content';
import Layout from '../../layouts/Layout.astro';
import BuiltinHeading from '../../components/BuiltinHeading.astro';
import { t, href, dateLabel, localize } from '../../lib/i18n';
import { publicRoute } from '../../lib/public-routes';
import { absoluteUrl } from '../../lib/seo';
const lang = pageLocale(Astro.routePattern);
const ui = t(lang);
const intro = await introFor('archives', lang);
const title = intro?.data.title ?? ui.archiveTitle;
const entries = (await discoverableEntries(lang))
  .filter((entry) => !(isReferral(entry) && entry.data.status === 'habis'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const groups = new Map<string, Entry[]>();
for (const entry of entries) {
  const year = new Intl.DateTimeFormat('en', {
    year: 'numeric',
    timeZone: config.site.timezone,
  }).format(entry.data.date);
  groups.set(year, [...(groups.get(year) ?? []), entry]);
}
---

<Layout
  lang={lang}
  title={title}
  description={intro?.data.description}
  active="archives"
  noindex={entries.length === 0}
  breadcrumbs={[
    {
      name: localize(config.text.tabs.search, lang),
      url: absoluteUrl(href(lang)),
    },
    {
      name: title,
      url: absoluteUrl(href(lang, `${publicRoute('archives')}/`)),
    },
  ]}
>
  <div class="content-column">
    <BuiltinHeading
      title={title}
      description={
        intro?.data.description ?? `${entries.length} ${ui.articleCount}`
      }
      eyebrow={ui.archives}
      icon="archive"
    />
    <ContentIntro entry={intro} />
    {[...groups].map(([year, yearEntries]) => (
      <section class="archive-year" id={year}>
        <h2>
          {year}
          <span>
            {yearEntries.length} {ui.articleCount}
          </span>
        </h2>
        {yearEntries.map((entry) => (
          <div class="archive-row">
            <time datetime={entry.data.date.toISOString()}>
              {dateLabel(entry.data.date, lang)
                .replace(year, '')
                .replace(/^[\s,.]+/, '')}
            </time>
            <a href={articleHref(entry, lang)}>{entry.data.title}</a>
          </div>
        ))}
      </section>
    ))}
  </div>
</Layout>

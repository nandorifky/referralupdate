---
import { localeInfo } from '../lib/translations';
import { ClientRouter } from 'astro:transitions';
import config from '../lib/config';
import Sidebar from '../components/Sidebar.astro';
import ComposerSuggestions from '../components/ComposerSuggestions.astro';
import SearchScope from '../components/SearchScope.astro';
import BlogStatistics from '../components/BlogStatistics.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { articleFeatures, type ArticleFeatures } from '../lib/article-options';
import ThemeIcon from '../components/ThemeIcon.astro';
import { t, href, localize, withBase } from '../lib/i18n';
import type { Locale } from '../types/config';
import '../styles/global.css';
import '../../custom/styles.css';
import customHead from '../../custom/head.html?raw';
import customBodyStart from '../../custom/body-start.html?raw';
import customBodyEnd from '../../custom/body-end.html?raw';
import katexStyles from 'katex/dist/katex.min.css?url';
import {
  discoverableArticles,
  discoverableEntries,
  articleHref,
  introFor,
} from '../lib/content';
import { htmlRoutes } from '../lib/html-routes';
import { isRealTranslation } from '../lib/locale-routing';
import {
  absoluteUrl,
  defaultSeoImage,
  ogLocale,
  pageJsonLd,
  seoImage,
  type Breadcrumb,
} from '../lib/seo';
interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  active?: string;
  noindex?: boolean;
  article?: boolean;
  shareImage?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  translationPaths?: Partial<Record<Locale, string>>;
  features?: ArticleFeatures;
  /** Schema.org page type; fall back to `article` prop. */
  pageType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  tags?: string[];
  breadcrumbs?: Breadcrumb[];
  prevUrl?: string;
  nextUrl?: string;
  imageAlt?: string;
  /** Pre-built JSON-LD graph; overrides the default page payload. */
  schema?: Record<string, unknown>;
}
const {
  lang,
  title,
  description,
  active,
  noindex = false,
  article = false,
  publishedTime,
  modifiedTime,
  section,
  tags,
  breadcrumbs,
  prevUrl,
  nextUrl,
  imageAlt,
} = Astro.props;
const ui = t(lang);
const features = Astro.props.features ?? articleFeatures({}, config.article);
const publicEntries = await discoverableEntries(lang);
const publicPosts = await discoverableArticles(lang);
const searchRecent = [...publicEntries]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
const prefix = href(lang);
const isHome =
  Astro.url.pathname.replace(/\/+$/, '') === href(lang).replace(/\/+$/, '');
const showViewSwitcher = isHome || active === 'posts';
const path = Astro.url.pathname.startsWith(prefix)
  ? Astro.url.pathname.slice(prefix.length)
  : '';
const alternatePaths: Partial<Record<Locale, string>> =
  Astro.props.alternatePaths ??
  Object.fromEntries(
    (
      await Promise.all(
        config.site.locales.map(async (locale) => {
          const target = href(locale, path);
          return (await htmlRoutes(locale)).includes(target)
            ? [[locale, target] as [Locale, string]]
            : [];
        }),
      )
    ).flat(),
  );
const pageTitle = title
  ? `${title} · ${localize(config.site.title, lang)}`
  : `${localize(config.site.title, lang)} · ${localize(config.text.siteDescription, lang)}`;
const canonical = absoluteUrl(Astro.url.pathname);
const pageDescription = (
  description ?? localize(config.text.siteDescription, lang)
).trim();
const seoAlt = imageAlt ?? pageTitle;
const ogImage =
  seoImage(Astro.props.shareImage, seoAlt, Astro.url.pathname) ??
  defaultSeoImage(seoAlt);
const schema =
  Astro.props.schema ??
  pageJsonLd({
    lang,
    url: canonical,
    title: pageTitle,
    description: pageDescription,
    image: ogImage,
    type: Astro.props.pageType ?? (article ? 'article' : 'website'),
    publishedTime,
    modifiedTime,
    section,
    tags,
    breadcrumbs,
  });
const robotsContent = noindex
  ? 'noindex,nofollow'
  : (config.seo?.robots ?? 'index,follow,max-image-preview:large');
const keywords = config.seo?.keywords
  ? localize(config.seo.keywords, lang)
  : undefined;
const introRoute = [
  'posts',
  'archives',
  'links',
  'categories',
  'tags',
].includes(active ?? '')
  ? active
  : undefined;
const translationPaths: Partial<Record<Locale, string>> =
  Astro.props.translationPaths ??
  Object.fromEntries(
    (
      await Promise.all(
        Object.entries(alternatePaths).map(async ([locale, target]) => {
          const intro = introRoute
            ? await introFor(introRoute, locale)
            : undefined;
          return !intro || isRealTranslation(intro, locale)
            ? [[locale, target!] as [Locale, string]]
            : [];
        }),
      )
    ).flat(),
  );
const customHtml = (html: string) =>
  html.replaceAll('%BASE_URL%', withBase(''));
const contentFade = {
  old: {
    name: 'blog-content-out',
    duration: '100ms',
    easing: 'ease-out',
    fillMode: 'both' as const,
  },
  new: {
    name: 'blog-content-in',
    duration: '120ms',
    easing: 'ease-out',
    fillMode: 'both' as const,
  },
};
const pageAnimation =
  config.appearance.pageTransition === 'fade'
    ? { forwards: contentFade, backwards: contentFade }
    : 'none';
---

<!doctype html>
<html
  lang={localeInfo(lang).lang}
  dir={localeInfo(lang).dir}
  data-default-theme={config.appearance.defaultTheme}
  data-theme="light"
  data-sidebar-default-width={config.sidebar.width.default}
  data-sidebar-min-width={config.sidebar.width.min}
  data-sidebar-max-width={config.sidebar.width.max}
  style={`--sidebar-width: ${config.sidebar.width.default}px`}
  transition:animate="none"
>
  <head>
    {features.math && <link rel="stylesheet" href={katexStyles} />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robotsContent} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta
      property="og:type"
      content={Astro.props.pageType ?? (article ? 'article' : 'website')}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={localize(config.site.title, lang)} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {config.site.locales
      .filter((locale) => locale !== lang)
      .map((locale) => (
        <meta property="og:locale:alternate" content={ogLocale(locale)} />
      ))}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage.url} />
        <meta property="og:image:secure_url" content={ogImage.url} />
        {ogImage.type && (
          <meta property="og:image:type" content={ogImage.type} />
        )}
        {ogImage.width && (
          <meta property="og:image:width" content={String(ogImage.width)} />
        )}
        {ogImage.height && (
          <meta property="og:image:height" content={String(ogImage.height)} />
        )}
        <meta property="og:image:alt" content={ogImage.alt ?? seoAlt} />
      </>
    )}
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
    )}
    {(modifiedTime ?? publishedTime) && (
      <meta
        property="article:modified_time"
        content={(modifiedTime ?? publishedTime)!.toISOString()}
      />
    )}
    {section && <meta property="article:section" content={section} />}
    {tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {!noindex && (
      <meta
        property="article:author"
        content={localize(config.author.name, lang)}
      />
    )}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    {config.seo?.twitter?.site && (
      <meta name="twitter:site" content={config.seo.twitter.site} />
    )}
    {config.seo?.twitter?.creator && (
      <meta name="twitter:creator" content={config.seo.twitter.creator} />
    )}
    {ogImage && (
      <>
        <meta name="twitter:image" content={ogImage.url} />
        <meta name="twitter:image:alt" content={ogImage.alt ?? seoAlt} />
      </>
    )}
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={absoluteUrl(prevUrl)} />}
    {nextUrl && <link rel="next" href={absoluteUrl(nextUrl)} />}
    {config.site.locales.length > 1 &&
      Object.entries(translationPaths).map(([locale, target]) => (
        <link
          rel="alternate"
          hreflang={localeInfo(locale).lang}
          href={absoluteUrl(target!)}
        />
      ))}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <meta name="theme-color" content="#171717" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${localize(config.site.title, lang)} RSS`}
      href={href(lang, 'rss.xml')}
    />
    <script is:inline>
      (() => {
        let theme = document.documentElement.dataset.defaultTheme || 'system';
        try {
          theme = localStorage.getItem('bloggpt-theme') || theme;
        } catch {
          /* Storage is optional. */
        }
        if (!['light', 'dark', 'system'].includes(theme)) theme = 'system';
        document.documentElement.dataset.theme =
          theme === 'system'
            ? matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : theme;
        try {
          const root = document.documentElement;
          const savedWidth = Number(
            localStorage.getItem('bloggpt-sidebar-width'),
          );
          const width = savedWidth || Number(root.dataset.sidebarDefaultWidth);
          root.style.setProperty(
            '--sidebar-width',
            `${Math.min(
              Number(root.dataset.sidebarMaxWidth),
              innerWidth > 760
                ? innerWidth - 320
                : Number(root.dataset.sidebarMaxWidth),
              Math.max(
                Number(root.dataset.sidebarMinWidth),
                Number.isFinite(width)
                  ? width
                  : Number(root.dataset.sidebarDefaultWidth),
              ),
            )}px`,
          );
          if (
            localStorage.getItem('bloggpt-sidebar') === 'collapsed' &&
            innerWidth > 760
          )
            document.documentElement.dataset.sidebar = 'collapsed';
        } catch {
          /* Storage is optional. */
        }
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
    <Fragment set:html={customHtml(customHead)} />
    <ClientRouter fallback="swap" />
  </head>
  <body
    data-base={withBase('')}
    data-locale-root={href(lang)}
    data-language-urls={JSON.stringify(
      Object.fromEntries(
        config.site.locales.map((locale) => [
          locale,
          alternatePaths[locale] ?? href(locale),
        ]),
      ),
    )}
    data-locale={lang}
    data-post-titles={JSON.stringify(
      publicEntries.map((entry) => ({
        title: entry.data.title,
        url: articleHref(entry, lang),
      })),
    )}
    data-completion-locales={JSON.stringify(
      config.site.locales.length > 1 ? config.site.locales : [],
    )}
    data-recent-urls={JSON.stringify(
      [...publicEntries]
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
        .slice(0, config.posts.randomLimit)
        .map((entry) => articleHref(entry, lang)),
    )}
    data-search-dev={import.meta.env.DEV ? 'true' : 'false'}
    data-search-help={localize(config.text.searchHeading, lang)}
    data-mermaid={String(features.mermaid)}
    data-lightbox={String(features.lightbox)}
  >
    <Fragment set:html={customHtml(customBodyStart)} />
    <a class="skip-link" href="#main">
      {ui.skip}
    </a>
    <Sidebar lang={lang} active={active} alternatePaths={alternatePaths} />
    <div class="main-shell">
      <header class="topbar" data-pagefind-ignore>
        <div class="topbar-left">
          <button
            class="icon-button reopen-sidebar"
            data-sidebar-toggle
            aria-label={ui.sidebar}
            aria-controls="sidebar"
            aria-expanded="false"
            data-tooltip={ui.showSidebar}
            data-tooltip-shortcut="Ctrl+Shift+S"
          >
            <ThemeIcon name="panel-left" />
          </button>
        </div>
        {showViewSwitcher && (
          <nav class="view-switcher" aria-label={ui.browse}>
            <a
              href={href(lang)}
              aria-current={active === 'home' ? 'page' : undefined}
            >
              {localize(config.text.tabs.search, lang)}
            </a>
            <a
              href={href(lang, 'posts/')}
              aria-current={active !== 'home' ? 'page' : undefined}
            >
              {localize(config.text.tabs.posts, lang)}
            </a>
          </nav>
        )}
        <div class="topbar-actions">
          <button
            type="button"
            class="icon-button"
            data-toc-toggle
            aria-label={ui.articleToc}
            aria-controls="article-toc-panel"
            aria-expanded="false"
            data-tooltip={ui.articleToc}
            hidden
          >
            <ThemeIcon name="list-tree" />
          </button>
          <a
            class="icon-button"
            href={href(lang, 'rss.xml')}
            aria-label={ui.rss}
            data-tooltip={ui.rss}
          >
            <ThemeIcon name="rss" />
          </a>
        </div>
      </header>
      <main
        id="main"
        class:list={[{ 'article-main': article }]}
        transition:name="blog-content"
        transition:animate={pageAnimation}
      >
        <slot />
      </main>
      <SiteFooter lang={lang} />
    </div>
    <dialog
      id="search-dialog"
      class="search-dialog"
      aria-labelledby="search-dialog-title"
    >
      <div class="search-dialog-header">
        <h2 id="search-dialog-title" class="sr-only">
          {ui.search}
        </h2>
        <form role="search" action={href(lang, 'search/')} data-search-form>
          <input
            type="search"
            name="q"
            aria-label={ui.search}
            placeholder={`${ui.searchTooltip}…`}
            autocomplete="off"
          />
          <SearchScope lang={lang} id="scope-dialog" />
          <ComposerSuggestions lang={lang} id="suggestions-dialog" />
        </form>
        <button
          class="icon-button"
          data-close-search
          aria-label={ui.close}
          data-tooltip={ui.close}
        >
          <ThemeIcon name="x" />
        </button>
      </div>
      <div
        class="search-output"
        data-search-output
        aria-live="polite"
        aria-atomic="false"
      >
        <p class="search-recent-heading">{ui.recent}</p>
        {searchRecent.map((entry) => (
          <a class="search-recent-item" href={articleHref(entry, lang)}>
            <ThemeIcon name="message-circle" size={18} />
            <span>{entry.data.title}</span>
          </a>
        ))}
      </div>
    </dialog>
    <template data-search-recent>
      <p class="search-recent-heading">{ui.recent}</p>
      {searchRecent.map((entry) => (
        <a class="search-recent-item" href={articleHref(entry, lang)}>
          <ThemeIcon name="message-circle" size={18} />
          <span>{entry.data.title}</span>
        </a>
      ))}
    </template>
    <dialog
      id="shortcut-dialog"
      class="shortcut-dialog"
      aria-labelledby="shortcut-title"
    >
      <div class="shortcut-header">
        <h2 id="shortcut-title">{ui.shortcuts}</h2>
        <button
          type="button"
          class="icon-button"
          data-close-shortcuts
          aria-label={ui.close}
        >
          <ThemeIcon name="x" />
        </button>
      </div>
      <dl>
        <div>
          <dt>{ui.search}</dt>
          <dd>
            <kbd>Ctrl+K</kbd>
          </dd>
        </div>
        <div>
          <dt>{ui.sidebar}</dt>
          <dd>
            <kbd>Ctrl+Shift+S</kbd>
          </dd>
        </div>
        <div>
          <dt>{ui.home}</dt>
          <dd>
            <kbd>Ctrl+Shift+O</kbd>
          </dd>
        </div>
        <div>
          <dt>{ui.focusSearch}</dt>
          <dd>
            <kbd>Shift+Esc</kbd>
          </dd>
        </div>
        <div>
          <dt>{ui.shortcuts}</dt>
          <dd>
            <kbd>Ctrl+/</kbd>
          </dd>
        </div>
      </dl>
    </dialog>
    <div id="ui-tooltip" class="ui-tooltip" popover="manual" role="tooltip">
      <span data-tooltip-label></span>
      <kbd data-tooltip-key hidden></kbd>
    </div>
    <BlogStatistics lang={lang} posts={publicPosts} />
    <script>
      import '../scripts/ui';
      import '../scripts/article-features';
      import '../scripts/custom';
    </script>
    <Fragment set:html={customHtml(customBodyEnd)} />
  </body>
</html>
